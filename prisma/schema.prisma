generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Usuario {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  nome             String
  email            String   @unique
  senhaHash        String
  criadoEm         DateTime @default(now())

  personagens      Personagem[]
  rituaisCriados   Ritual[]
  periciasCriadas  Pericia[]
  itensCriados     Item[]
  campanhasMestre  Campanha[]
}

model Personagem {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  nome          String
  classe        Classe
  trilha        String?
  nex           Int      @default(5)

  agilidade     Int      @default(1)
  forca         Int      @default(1)
  intelecto     Int      @default(1)
  presenca      Int      @default(1)
  vigor         Int      @default(1)

  pvAtual       Int      @default(0)
  peAtual       Int      @default(0)
  sanidadeAtual Int      @default(0)

  criadoEm      DateTime @default(now())

  usuario       Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioId     String   @db.ObjectId

  origem        Origem?  @relation(fields: [origemId], references: [id])
  origemId      String?  @db.ObjectId

  pericias      PersonagemPericia[]
  itens         PersonagemItem[]
  rituais       PersonagemRitual[]
  habilidades   Habilidade[]

  campanha      Campanha? @relation(fields: [campanhaId], references: [id])
  campanhaId    String?   @db.ObjectId
}

enum Classe {
  COMBATENTE
  ESPECIALISTA
  OCULTISTA
}

model Pericia {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  nome         String   @unique
  atributoBase String
  soTreinada   Boolean  @default(false)
  carga        Boolean  @default(false)
  kit          Boolean  @default(false)

  origem       OrigemPericia @default(OFICIAL)
  criadoPor    Usuario?      @relation(fields: [criadoPorId], references: [id])
  criadoPorId  String?       @db.ObjectId

  campanha     Campanha?     @relation(fields: [campanhaId], references: [id])
  campanhaId   String?       @db.ObjectId

  personagens  PersonagemPericia[]
}

enum OrigemPericia {
  OFICIAL
  CUSTOMIZADO
}

model PersonagemPericia {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  treino        Treino     @default(LEIGO)

  personagem    Personagem @relation(fields: [personagemId], references: [id])
  personagemId  String     @db.ObjectId

  pericia       Pericia    @relation(fields: [periciaId], references: [id])
  periciaId     String     @db.ObjectId

  @@unique([personagemId, periciaId])
}

enum Treino {
  LEIGO
  TREINADO
  VETERANO
  EXPERT
}

model Ritual {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  nome         String
  circulo      Int
  elemento     String
  custoPE      Int
  descricao    String

  origem       OrigemRitual @default(OFICIAL)
  livro        String?
  criadoPor    Usuario?     @relation(fields: [criadoPorId], references: [id])
  criadoPorId  String?      @db.ObjectId

  campanha     Campanha?    @relation(fields: [campanhaId], references: [id])
  campanhaId   String?      @db.ObjectId

  personagens  PersonagemRitual[]
}

enum OrigemRitual {
  OFICIAL
  CUSTOMIZADO
}

model PersonagemRitual {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId

  personagem    Personagem @relation(fields: [personagemId], references: [id])
  personagemId  String     @db.ObjectId

  ritual        Ritual     @relation(fields: [ritualId], references: [id])
  ritualId      String     @db.ObjectId

  @@unique([personagemId, ritualId])
}

model Item {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  nome         String
  descricao    String?

  categoria    String?
  espacos      Int      @default(1)

  dano         String?
  critico      String?
  alcance      String?
  tipoDano     String?

  origem       OrigemItem @default(OFICIAL)
  livro        String?
  criadoPor    Usuario?   @relation(fields: [criadoPorId], references: [id])
  criadoPorId  String?    @db.ObjectId

  campanha     Campanha?  @relation(fields: [campanhaId], references: [id])
  campanhaId   String?    @db.ObjectId

  personagens  PersonagemItem[]
}

enum OrigemItem {
  OFICIAL
  CUSTOMIZADO
}

model PersonagemItem {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  quantidade    Int        @default(1)

  personagem    Personagem @relation(fields: [personagemId], references: [id])
  personagemId  String     @db.ObjectId

  item          Item       @relation(fields: [itemId], references: [id])
  itemId        String     @db.ObjectId

  @@unique([personagemId, itemId])
}

model Origem {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  nome           String   @unique
  poderNome      String
  poderDescricao String

  personagens    Personagem[]
}

model Habilidade {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  nome         String
  descricao    String
  tipo         TipoHabilidade

  personagem   Personagem @relation(fields: [personagemId], references: [id])
  personagemId String     @db.ObjectId
}

enum TipoHabilidade {
  ORIGEM
  TRILHA
  CLASSE
  PODER_PARANORMAL
}

model Campanha {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  nome        String
  descricao   String?
  criadoEm    DateTime @default(now())

  mestre      Usuario  @relation(fields: [mestreId], references: [id])
  mestreId    String   @db.ObjectId

  personagens          Personagem[]
  periciasCustomizadas Pericia[]
  rituaisCustomizados  Ritual[]
  itensCustomizados    Item[]
}